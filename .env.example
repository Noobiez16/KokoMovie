# KokoMovie runtime environment overrides (all optional)

# Leave unset in normal development. The user enters TMDB credentials in Settings.

# Optional certificate pin for packaged API endpoints.
API_CERT_FINGERPRINT=

# Diagnostic compatibility switch for isolated provider extraction windows.
FORCE_WEB_SECURITY=false

# Optional Discord Rich Presence application ID override.
KOKOMOVIE_DISCORD_CLIENT_ID=
